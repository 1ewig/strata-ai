# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="your-gemini-api-key"

# GOOGLE_GENERATIVE_AI_API_KEY: Required by Vercel AI SDK (@ai-sdk/google).
GOOGLE_GENERATIVE_AI_API_KEY="your-gemini-api-key"

# FIREWORKS_API_KEY: Required for Fireworks-hosted models (DeepSeek V4 Flash 0731).
# Used by the @ai-sdk/fireworks provider.
FIREWORKS_API_KEY="your-fireworks-api-key"

# NEXT_PUBLIC_GEMINI_MODEL: The Gemini model to use for the AI agent and display.
NEXT_PUBLIC_GEMINI_MODEL="gemini-3.1-flash-lite"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# SUPABASE
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# DATABASE_URL: Direct PostgreSQL Connection String for Supabase (required for Better Auth migrations and direct DB access).
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# BETTER AUTH
BETTER_AUTH_SECRET="your-better-auth-secret-min-32-chars"
BETTER_AUTH_URL="http://localhost:3000"

# NEXT_PUBLIC_APP_URL: Public-facing app URL (used by the auth client on the browser)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# TAVILY_API_KEY: Optional key for webSearch agent tool
TAVILY_API_KEY="your-tavily-api-key"

# LANGFUSE: Optional LLM observability and tracing via OpenTelemetry (passive when unset)
LANGFUSE_SECRET_KEY="sk-lf-your-secret-key"
LANGFUSE_PUBLIC_KEY="pk-lf-your-public-key"
LANGFUSE_BASE_URL="https://cloud.langfuse.com"