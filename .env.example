# GOOGLE_GENERATIVE_AI_API_KEY: Required for Gemini AI API calls.
# Used by @ai-sdk/google provider. Same as the old GEMINI_API_KEY.
GOOGLE_GENERATIVE_AI_API_KEY="MY_GEMINI_API_KEY"

# NEXT_PUBLIC_GEMINI_MODEL: The default model to use (e.g. gemini-3.5-flash, gemini-3.5-flash-lite,
# gemini-3.1-flash-lite, gemini-3-flash-preview, gemma-4-31b-it, gemma-4-26b-a4b-it)
NEXT_PUBLIC_GEMINI_MODEL="gemini-3.5-flash-lite"

# APP_URL: The base URL where this application is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"

# SUPABASE: Credentials for Supabase PostgreSQL and Authentication.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# DATABASE_URL: Direct PostgreSQL Connection String for Supabase
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# BETTER AUTH
BETTER_AUTH_SECRET="your-better-auth-secret-min-32-chars"
BETTER_AUTH_URL="http://localhost:3000"

# NEXT_PUBLIC_APP_URL: Public-facing app URL (used by the auth client on the browser)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# TAVILY_API_KEY: Optional key for webSearch agent tool
TAVILY_API_KEY="your-tavily-api-key-here"

