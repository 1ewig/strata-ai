# ==============================================================================
# STRATA AI - ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================
# Copy this file to .env.local and populate the values for local development.
# For production (e.g. Vercel), add these key-value pairs to the environment variables dashboard.

# ------------------------------------------------------------------------------
# 1. APPLICATION & ROUTING
# ------------------------------------------------------------------------------
# APP_URL: Base URL for server-side redirects and internal resolution.
APP_URL="http://localhost:3000"

# NEXT_PUBLIC_APP_URL: Public-facing URL used by browser-side auth clients.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION (Better Auth & OAuth)
# ------------------------------------------------------------------------------
# BETTER_AUTH_SECRET: Secret key for encrypting sessions and cookies (min 32 chars).
# Generate via: openssl rand -base64 32
BETTER_AUTH_SECRET="your-better-auth-secret-min-32-chars"

# BETTER_AUTH_URL: Base URL used by Better Auth server handlers.
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth 2.0 Credentials (Google Cloud Console -> Credentials -> OAuth 2.0 Client ID)
# Authorized Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ------------------------------------------------------------------------------
# 3. DATABASE & STORAGE (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# DATABASE_URL: Direct PostgreSQL connection string (pooled / session pooler port 6543 or 5432).
# Used by Better Auth and custom database queries.
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# Supabase Client Credentials
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# ------------------------------------------------------------------------------
# 4. AI PROVIDERS & MODELS
# ------------------------------------------------------------------------------
# Google Gemini API key (Google AI Studio)
GEMINI_API_KEY="your-gemini-api-key"
GOOGLE_GENERATIVE_AI_API_KEY="your-gemini-api-key"

# Default Gemini model identifier
NEXT_PUBLIC_GEMINI_MODEL="gemini-3.1-flash-lite"

# Fireworks AI: For hosting DeepSeek / open models via @ai-sdk/fireworks
FIREWORKS_API_KEY="your-fireworks-api-key"

# ------------------------------------------------------------------------------
# 5. AGENT TOOLS & EXTERNAL SEARCH
# ------------------------------------------------------------------------------
# Tavily API: Used by web search agent tools
TAVILY_API_KEY="your-tavily-api-key"

# ------------------------------------------------------------------------------
# 6. OBSERVABILITY & TRACING (Langfuse / OpenTelemetry)
# ------------------------------------------------------------------------------
# Optional: tracing and metrics for LLM calls (passive when empty)
LANGFUSE_SECRET_KEY="sk-lf-your-secret-key"
LANGFUSE_PUBLIC_KEY="pk-lf-your-public-key"
LANGFUSE_BASE_URL="https://cloud.langfuse.com"
